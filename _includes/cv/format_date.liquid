{%- comment -%}
  Local addition: formats a CV date for the date badges.
  "2025-10" -> "Oct 2025", "2024" -> "2024", "present" -> "Present".
{%- endcomment -%}
{%- assign fd_value = include.value | append: '' | strip -%}
{%- assign fd_lower = fd_value | downcase -%}
{%- if fd_lower == 'present' -%}
  Present
{%- elsif fd_value != '' -%}
  {%- assign fd_parts = fd_value | split: '-' -%}
  {%- if fd_parts.size > 1 -%}
    {%- assign fd_months = 'Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec' | split: ',' -%}
    {%- assign fd_index = fd_parts[1] | plus: 0 | minus: 1 -%}
    {{- fd_months[fd_index] | append: ' ' | append: fd_parts[0] -}}
  {%- else -%}
    {{- fd_parts[0] -}}
  {%- endif -%}
{%- endif -%}
